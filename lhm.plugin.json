{
  "description": "Production-ready Docker infrastructure for Model Context Protocol (MCP). Multiplexes multiple MCP servers into a single SSE endpoint.",
  "icon": "🍱",
  "identifier": "brainoir-mcp-supergateway-aggregator",
  "name": "MCP Monolithic Aggregator",
  "version": "1.5.0",
  "tools": [
    {
      "name": "tavily_search",
      "description": "Performs a web search to find relevant information",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "read_file",
      "description": "Read contents of a file from the local filesystem",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path to the file"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "write_file",
      "description": "Create a new file or completely overwrite an existing file with new content",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path to the file"
          },
          "content": {
            "type": "string",
            "description": "Content of the file"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "name": "resolve-library-id",
      "description": "Resolve a library name to a Context7-compatible library ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "libraryName": {
            "type": "string",
            "description": "The name of the library"
          }
        },
        "required": [
          "libraryName"
        ]
      }
    },
    {
      "name": "get-library-docs",
      "description": "Fetch documentation for a specified library by its Context7 library ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "context7CompatibleLibraryID": {
            "type": "string",
            "description": "The Context7 library ID"
          }
        },
        "required": [
          "context7CompatibleLibraryID"
        ]
      }
    },
    {
      "name": "search_code",
      "description": "Search code across GitHub repositories",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "search_repositories",
      "description": "Search GitHub repositories",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  ]
}
